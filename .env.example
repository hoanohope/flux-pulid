# Copy to .env and fill in. NEVER commit the real .env file.

# Hugging Face token (Read scope). The account must have accepted the FLUX.1-dev license.
# Only needed to download tokenizers the first time (on Kaggle use Add-ons -> Secrets instead).
HF_TOKEN=your_huggingface_token_here

# Optional: GitHub token if you push from a notebook.
GH_TOKEN=your_github_token_here
